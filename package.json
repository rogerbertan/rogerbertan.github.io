{
  "name": "rogerbertan-github-io",
  "version": "1.0.0",
  "description": "Blog pessoal sobre engenharia de software.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerbertan/rogerbertan.github.io.git"
  },
  "author": "Roger Bertan",
  "license": "MIT",
  "private": true,
  "homepage": "https://rogerbertan.github.io",
  "type": "module",
  "scripts": {
    "build": "concurrently npm:build:*",
    "build:css": "node purgecss.js",
    "build:js": "rollup -c --bundleConfigAsCjs --environment BUILD:production",
    "watch:js": "rollup -c --bundleConfigAsCjs -w",
    "lint:js": "eslint",
    "lint:scss": "stylelint _sass/**/*.scss",
    "lint:fix:scss": "npm run lint:scss -- --fix",
    "test": "npm run lint:js && npm run lint:scss"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-private-methods": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "purgecss": "^8.0.0",
    "rollup": "^4.62.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0"
  },
  "prettier": {
    "trailingComma": "none"
  },
  "browserslist": [
    "last 2 versions",
    "> 0.2%",
    "not dead"
  ]
}